{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blitzko",
  "version": "0.1.9",
  "identifier": "com.dany.blitzko",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blitzko",
        "width": 960,
        "height": 820,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwMzkwRDYwQUEwMjJFNjgKUldSb0xnS3FZQTA1d0FLaFZBZWZhUGQyYU1vQ0hXZXFQZ09aVURFVmlkNE1VVERzczhMVW53YnIK",
      "endpoints": [
        "https://github.com/Aquyron/blitzko/releases/latest/download/latest.json"
      ]
    }
  }
}
